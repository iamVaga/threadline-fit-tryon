# Copy to .env and fill in ONE backend. Never commit .env.
TRYON_REMOTE=1
TRYON_BACKEND=gemini        # gemini (best quality, full-length kurtas), hf (free, upper body only) or replicate
HF_TOKEN=                   # https://huggingface.co/settings/tokens  (a "Read" token is enough)
GEMINI_API_KEY=             # https://aistudio.google.com/apikey
# GEMINI_MODEL=             # optional; leave unset to auto-pick an image model
REPLICATE_API_TOKEN=        # https://replicate.com/account/api-tokens
TRYON_TEAM_CODE=fitcheck    # code you type in the page's "Team access code" box
